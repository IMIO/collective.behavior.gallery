<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup">


  <genericsetup:registerProfile
      name="upgrade_1001_to_1002"
      title="Upgrade collective.behavior.gallery from 1001 to 1002"
      directory="profiles/1001_to_1002"
      description="Migrate bundles / resources to simplified resources registry"
      provides="Products.GenericSetup.interfaces.EXTENSION" />


  <genericsetup:upgradeStep
    source="1000"
    destination="1001"
    title="Reload GS profiles"
    description=""
    profile="collective.behavior.gallery:default"
    handler=".upgrades.reload_registry_profile"
    />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="collective.behavior.gallery:default">
    <genericsetup:upgradeDepends
        title="Migrate bundles / resources to simplified resources registry"
        import_profile="collective.behavior.gallery.upgrades:upgrade_1001_to_1002"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>


</configure>
